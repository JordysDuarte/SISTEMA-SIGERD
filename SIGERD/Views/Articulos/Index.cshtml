@model IEnumerable<SIGERD.ViewModels.Inventario.Articulos.ArticuloListViewModel>

@{
    ViewData["Title"] = "Artículos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Artículos</h2>
        <p class="text-muted mb-0">
            Administra los artículos, documentos o recursos que pueden incluirse en los envíos.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>
        Nuevo artículo
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Listado de artículos</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Artículo</th>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var articulo in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@articulo.NombreArticulo</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(articulo.Descripcion)
                                        ? "Sin descripción"
                                        : articulo.Descripcion)
                                </td>

                                <td>
                                    @articulo.Categoria
                                </td>

                                <td>
                                    @if (articulo.Estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@articulo.IdArticulo"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ver detalle">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@articulo.IdArticulo"
                                       class="btn btn-sm btn-outline-warning"
                                       title="Editar artículo">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    @if (articulo.Estado)
                                    {
                                        <form asp-action="CambiarEstado"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@articulo.IdArticulo" />
                                            <input type="hidden" name="nuevoEstado" value="false" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Desactivar artículo"
                                                    onclick="return confirm('¿Deseas desactivar este artículo?');">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="CambiarEstado"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@articulo.IdArticulo" />
                                            <input type="hidden" name="nuevoEstado" value="true" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Activar artículo"
                                                    onclick="return confirm('¿Deseas activar este artículo?');">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No hay artículos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
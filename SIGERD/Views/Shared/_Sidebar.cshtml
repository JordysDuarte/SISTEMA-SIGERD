@using SIGERD.Constants.Seguridad

@{
    string? controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();

    bool dashboardActivo = string.Equals(
        controladorActual,
        "Dashboard",
        StringComparison.OrdinalIgnoreCase
    );

    bool usuariosActivo = string.Equals(
        controladorActual,
        "Usuarios",
        StringComparison.OrdinalIgnoreCase
    );

    bool rolesActivo = string.Equals(
        controladorActual,
        "Roles",
        StringComparison.OrdinalIgnoreCase
    );

    bool enviosActivo = string.Equals(
        controladorActual,
        "Envios",
        StringComparison.OrdinalIgnoreCase
    );

    bool despachosActivo = string.Equals(
    controladorActual,
    "Despachos",
    StringComparison.OrdinalIgnoreCase
    );

    bool recepcionesActivo = string.Equals(
    controladorActual,
    "Recepciones",
    StringComparison.OrdinalIgnoreCase
);

    bool esSuperAdministrador = User.IsInRole(RolesSistema.SuperAdministrador);
}

<div class="sidebar">

    <div class="sidebar-header">

        <i class="bi bi-box-seam-fill"></i>

        <span>SIGERD</span>

    </div>

    <ul class="sidebar-menu">

        <li>
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="@(dashboardActivo ? "active" : "")">

                <i class="bi bi-speedometer2"></i>

                <span>Dashboard</span>

            </a>
        </li>

        @if (esSuperAdministrador)
        {
            <li class="menu-title">
                Seguridad
            </li>

            <li>
                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="@(usuariosActivo ? "active" : "")">

                    <i class="bi bi-people-fill"></i>

                    <span>Usuarios</span>

                </a>
            </li>

            <li>
                <a asp-controller="Roles"
                   asp-action="Index"
                   class="@(controladorActual == "Roles" ? "active" : "")">
                    <i class="bi bi-shield-lock"></i>
                    <span>Roles</span>
                </a>
            </li>
        }

        <li class="menu-title">
            Operaciones
        </li>

        <li>
            <a asp-controller="Envios"
                asp-action="Index"
                class="@(enviosActivo ? "active" : "")">

                <i class=" bi-send-fill"></i>

                <span>Envíos</span>
            </a>
        </li>
        <li>
            <li>
                <a asp-controller="Recepciones"
                   asp-action="Index"
                   class="@(recepcionesActivo ? "active" : "")">
                    <i class="bi bi-arrow-down-square-fill"></i>
                    <span>Recepciones</span>
                </a>
            </li>
        </li>

        <li>
            <a asp-controller="Despachos"
               asp-action="Index"
               class="@(despachosActivo ? "active" : "")">

                <i class=" bi bi-arrow-up-square-fill"></i>

                <span>Despachos</span>

            </a>
        </li>

        

        <li class="menu-title">
            Inventario
        </li>
        <li>
            <a href="#">

                <i class="bi bi-box-fill"></i>

                <span>Artículos</span>

            </a>
        </li>
        <li>
            <a href="#">
                <i class="bi bi-tags-fill"></i>
                <span>Categorías</span>
            </a>
        </li>

        <li class="menu-title">
            Reportes
        </li>

        <li>
            <a href="#">

                <i class="bi bi-bar-chart-fill"></i>

                <span>Reportes</span>

            </a>
        </li>

    </ul>

</div>
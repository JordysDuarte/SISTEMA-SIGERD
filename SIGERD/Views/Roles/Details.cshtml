@model SIGERD.ViewModels.Seguridad.Roles.RolDetailsViewModel

@{
    ViewData["Title"] = "Detalle del rol";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Detalle del rol</h2>
        <p class="text-muted mb-0">
            Información general del rol seleccionado.
        </p>
    </div>

    <div class="d-flex gap-2">
        @if (!Model.EsRolBase)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.IdRol"
               class="btn btn-outline-warning">
                <i class="bi bi-pencil-square me-2"></i>
                Editar
            </a>
        }

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Volver
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Información del rol</h5>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.IdRol</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.NombreRol</dd>

            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Descripcion)
                    ? "Sin descripción"
                    : Model.Descripcion)
            </dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">
                @if (Model.EsRolBase)
                {
                    <span class="badge bg-primary">Rol base del sistema</span>
                }
                else
                {
                    <span class="badge bg-secondary">Rol personalizado</span>
                }
            </dd>
        </dl>
    </div>
</div>
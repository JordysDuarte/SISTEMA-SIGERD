@model IEnumerable<SIGERD.ViewModels.Seguridad.Roles.RolListViewModel>

@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Roles</h2>
        <p class="text-muted mb-0">
            Administra los roles disponibles en el sistema.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>
        Nuevo rol
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Listado de roles</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Rol</th>
                        <th>Descripción</th>
                        <th>Tipo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var rol in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@rol.NombreRol</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(rol.Descripcion)
                                        ? "Sin descripción"
                                        : rol.Descripcion)
                                </td>

                                <td>
                                    @if (rol.EsRolBase)
                                    {
                                        <span class="badge bg-primary">
                                            Rol base
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Personalizado
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@rol.IdRol"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ver detalle">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    @if (!rol.EsRolBase)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@rol.IdRol"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Editar rol">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No hay roles registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
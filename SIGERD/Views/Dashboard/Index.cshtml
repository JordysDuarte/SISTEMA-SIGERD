@model SIGERD.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Dashboard</h2>
        <p class="text-muted mb-0">
            @Model.TituloContexto
        </p>
    </div>

    <div class="text-md-end">
        <div class="fw-semibold">@Model.NombreUsuario</div>
        <small class="text-muted">@Model.NombreDelegacion</small>
    </div>
</div>

@if (Model.EsSuperAdministrador)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Usuarios</div>
                    <h3 class="mb-0">@Model.TotalUsuarios</h3>
                    <small class="text-muted">Usuarios registrados</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Artículos</div>
                    <h3 class="mb-0">@Model.TotalArticulos</h3>
                    <small class="text-muted">Artículos registrados</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Envíos</div>
                    <h3 class="mb-0">@Model.TotalEnvios</h3>
                    <small class="text-muted">Envíos totales</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Recepciones</div>
                    <h3 class="mb-0">@Model.TotalRecepciones</h3>
                    <small class="text-muted">Recepciones registradas</small>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    @if (!Model.EsSuperAdministrador)
    {
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Enviados</div>
                    <h3 class="mb-0">@Model.EnviosEnviados</h3>
                    <small class="text-muted">Envíos desde mi delegación</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Destinados</div>
                    <h3 class="mb-0">@Model.EnviosDestinados</h3>
                    <small class="text-muted">Envíos hacia mi delegación</small>
                </div>
            </div>
        </div>
    }

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">Pendientes de despacho</div>
                <h3 class="mb-0">@Model.PendientesDespacho</h3>
                <small class="text-muted">Envíos pendientes de salida</small>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">Pendientes de recepción</div>
                <h3 class="mb-0">@Model.PendientesRecepcion</h3>
                <small class="text-muted">Envíos pendientes de recibir</small>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">En tránsito</div>
                <h3 class="mb-0">@Model.EnviosEnTransito</h3>
                <small class="text-muted">Envíos actualmente en tránsito</small>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">Recibidos</div>
                <h3 class="mb-0">@Model.EnviosRecibidos</h3>
                <small class="text-muted">Envíos con recepción confirmada</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
            <h5 class="mb-0">Últimos envíos</h5>
            <small class="text-muted">
                @(Model.EsSuperAdministrador
                    ? "Últimos movimientos registrados en el sistema."
                    : "Últimos movimientos relacionados con tu delegación.")
            </small>
        </div>

        <a asp-controller="Envios" asp-action="Index" class="btn btn-sm btn-outline-primary">
            Ver envíos
        </a>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Fecha</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.UltimosEnvios != null && Model.UltimosEnvios.Any())
                    {
                        foreach (var envio in Model.UltimosEnvios)
                        {
                            string estado = envio.EstadoEnvio?.Trim().ToLower() ?? string.Empty;

                            string claseEstado = estado switch
                            {
                                "pendiente" => "bg-warning",
                                "en tránsito" => "bg-info text-dark",
                                "en transito" => "bg-info text-dark",
                                "recibido" => "bg-success",
                                "cancelado" => "bg-danger",
                                "extraviado" => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td>
                                    <strong>@envio.CodigoEnvio</strong>
                                </td>

                                <td>
                                    @envio.FechaEnvio.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @envio.DelegacionOrigen
                                </td>

                                <td>
                                    @envio.DelegacionDestino
                                </td>

                                <td>
                                    <span class="badge @claseEstado">
                                        @envio.EstadoEnvio
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Envios"
                                       asp-action="Details"
                                       asp-route-id="@envio.IdEnvio"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No hay envíos recientes para mostrar.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
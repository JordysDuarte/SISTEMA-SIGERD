@model SIGERD.ViewModels.Seguridad.Usuarios.UsuarioResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>
        <h2 class="mb-1">Restablecer Contraseña</h2>

        <p class="text-muted mb-0">
            Asigna una nueva contraseña temporal al usuario seleccionado.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Volver al listado
    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-4">

        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Después de restablecer la contraseña, el usuario deberá cambiarla al iniciar sesión.
        </div>

        <div class="mb-4">
            <h5 class="mb-1">@Model.NombreCompleto</h5>
            <span class="text-muted">@Model.NombreUsuario</span>
        </div>

        <form asp-action="ResetPassword" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="idUsuario" type="hidden" />
            <input asp-for="NombreCompleto" type="hidden" />
            <input asp-for="NombreUsuario" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-12 col-md-6">

                    <label asp-for="NuevaClave" class="form-label"></label>

                    <div class="password-field">
                        <input asp-for="NuevaClave"
                               type="password"
                               class="form-control pe-5"
                               placeholder="Ingrese la nueva contraseña"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle-button"
                                data-toggle-password
                                title="Mostrar contraseña"
                                aria-label="Mostrar contraseña">

                            <i class="bi bi-eye"></i>

                        </button>
                    </div>

                    <span asp-validation-for="NuevaClave" class="text-danger"></span>

                </div>

                <div class="col-12 col-md-6">

                    <label asp-for="ConfirmarNuevaClave" class="form-label"></label>

                    <div class="password-field">
                        <input asp-for="ConfirmarNuevaClave"
                               type="password"
                               class="form-control pe-5"
                               placeholder="Confirme la nueva contraseña"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle-button"
                                data-toggle-password
                                title="Mostrar contraseña"
                                aria-label="Mostrar contraseña">

                            <i class="bi bi-eye"></i>

                        </button>
                    </div>

                    <span asp-validation-for="ConfirmarNuevaClave" class="text-danger"></span>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary"
                        onclick="return confirm('¿Está seguro que desea restablecer la contraseña de este usuario?');">

                    <i class="bi bi-key-fill me-2"></i>
                    Restablecer contraseña

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model IEnumerable<SIGERD.ViewModels.Seguridad.Usuarios.UsuarioListViewModel>

@{
    ViewData["Title"] = "Usuarios";
}





    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="mb-0">
            Gestión de Usuarios
        </h2>

        

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            Nuevo Usuario

        </a>

    </div>

    <partial name="_Alerts" />

    <div class="card shadow-sm border-0 mt-4 p-3 rounded-3">

    <table class="table table-hover align-middle mb-0">

        <thead class="table-dark h5">

            <tr>

                <th>Nombre</th>

                <th>Correo</th>

                <th>Rol</th>

                <th>Estado</th>

                <th width="220" class="align-items-center text-center">Acciones</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {

                <tr>

                    <td>@item.NombreCompleto</td>

                    <td>@item.Correo</td>

                    <td>@item.Rol</td>

                    <td>

                        @if (item.Estado)
                        {
                            <span class="badge bg-success">

                                Activo

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">

                                Inactivo

                            </span>
                        }

                    </td>

                    <td align="center">

                        <a asp-action="Details"
                           asp-route-id="@item.IdUsuario"
                           title="Detalles"
                           class="bi bi-eye-fill btn btn-sm btn-outline-primary align-items-center w-23  text-decoration-none">
                            
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.IdUsuario"
                           title="Editar"
                           class="bi bi-pencil-square btn btn-warning btn-sm align-items-center  w-23">

                        </a>

                        @if (item.Estado)
                        {
                            <form asp-action="CambiarEstado"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@item.IdUsuario" />
                                <input type="hidden" name="nuevoEstado" value="false" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger w-23"
                                        title="Desactivar usuario"
                                        onclick="return confirm('¿Está seguro que desea desactivar este usuario?');">
                                    <i class="bi bi-toggle2-off"></i>

                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-action="CambiarEstado"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@item.IdUsuario" />
                                <input type="hidden" name="nuevoEstado" value="true" />

                                <button type="submit"
                                        class="btn btn-sm btn-success w-23"
                                        title="Activar usuario"
                                        onclick="return confirm('¿Está seguro que desea activar este usuario?');">
                                    <i class="bi bi-toggle-on"></i>

                 

                                </button>

                            </form>
                        }

                        <a asp-action="ResetPassword"
                           asp-route-id="@item.IdUsuario"
                           class=""
                           title="Restablecer contraseña">

                            <i class="bi bi-key-fill btn btn-sm btn-primary w-23"></i>

                        </a>

                    </td>

                </tr>

            }

        </tbody>

    </table>

</div>
@model IEnumerable<SIGERD.ViewModels.Despachos.DespachoListViewModel>

@{
    ViewData["Title"] = "Despachos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Despachos</h2>
        <p class="text-muted mb-0">
            Confirma la salida física de los envíos pendientes.
        </p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Envíos pendientes de despacho</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Fecha creación</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Usuario registra</th>
                        <th>Artículos</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var envio in Model)
                        {
                            <tr>
                                <td>@envio.CodigoEnvio</td>

                                <td>@envio.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>

                                <td>@envio.DelegacionOrigen</td>

                                <td>@envio.DelegacionDestino</td>

                                <td>@envio.UsuarioEnvio</td>

                                <td>@envio.TotalArticulos</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @envio.EstadoEnvio
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Envios"
                                       asp-action="Details"
                                       asp-route-id="@envio.IdEnvio"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ver detalle">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <form asp-action="Despachar"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@envio.IdEnvio" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                title="Despachar envío"
                                                onclick="return confirm('¿Confirma que este envío ya salió físicamente hacia la delegación destino?');">
                                            <i class="bi bi-truck"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No hay envíos pendientes de despacho.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model SIGERD.ViewModels.Recepciones.RecepcionDetailsViewModel

@{
    ViewData["Title"] = "Detalle de recepción";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Detalle de recepción</h2>
        <p class="text-muted mb-0">
            Información completa de la recepción registrada.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Envios"
           asp-action="Details"
           asp-route-id="@Model.IdEnvio"
           class="btn btn-outline-primary">
            <i class="bi bi-eye me-2"></i>
            Ver envío
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Volver
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Datos generales</h5>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Código envío</dt>
            <dd class="col-sm-9">@Model.CodigoEnvio</dd>

            <dt class="col-sm-3">Fecha envío</dt>
            <dd class="col-sm-9">@Model.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Fecha despacho</dt>
            <dd class="col-sm-9">
                @(Model.FechaDespacho.HasValue
                    ? Model.FechaDespacho.Value.ToString("dd/MM/yyyy HH:mm")
                    : "Sin fecha")
            </dd>

            <dt class="col-sm-3">Fecha recepción</dt>
            <dd class="col-sm-9">@Model.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Origen</dt>
            <dd class="col-sm-9">@Model.DelegacionOrigen</dd>

            <dt class="col-sm-3">Destino</dt>
            <dd class="col-sm-9">@Model.DelegacionDestino</dd>

            <dt class="col-sm-3">Usuario registra</dt>
            <dd class="col-sm-9">@Model.UsuarioEnvio</dd>

            <dt class="col-sm-3">Usuario despacha</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.UsuarioDespacho)
                    ? "Sin usuario"
                    : Model.UsuarioDespacho)
            </dd>

            <dt class="col-sm-3">Usuario recibe</dt>
            <dd class="col-sm-9">@Model.UsuarioRecepcion</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge bg-success">@Model.EstadoEnvio</span>
            </dd>

            <dt class="col-sm-3">Observaciones</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Observaciones)
                    ? "Sin observaciones"
                    : Model.Observaciones)
            </dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Detalle recibido</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Artículo / documento</th>
                        <th>Cantidad</th>
                        <th>Descripción</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Detalles != null && Model.Detalles.Any())
                    {
                        int contador = 1;

                        foreach (var detalle in Model.Detalles)
                        {
                            <tr>
                                <td>@contador</td>
                                <td>@detalle.Articulo</td>
                                <td>@detalle.Cantidad</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(detalle.ObservacionesDetalle)
                                        ? "Sin descripción"
                                        : detalle.ObservacionesDetalle)
                                </td>
                            </tr>

                            contador++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No hay detalles registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
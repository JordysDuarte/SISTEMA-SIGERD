@model IEnumerable<SIGERD.ViewModels.Recepciones.RecepcionEnvioListViewModel>

@{
    ViewData["Title"] = "Recepciones";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Recepciones</h2>
        <p class="text-muted mb-0">
            Confirma la recepción de los envíos destinados a tu delegación.
        </p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Envíos pendientes de recepción</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Fecha despacho</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Usuario despachó</th>
                        <th>Artículos</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var envio in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@envio.CodigoEnvio</strong>
                                </td>

                                <td>
                                    @(envio.FechaDespacho.HasValue
                                        ? envio.FechaDespacho.Value.ToString("dd/MM/yyyy HH:mm")
                                        : "Sin fecha")
                                </td>

                                <td>@envio.DelegacionOrigen</td>

                                <td>@envio.DelegacionDestino</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(envio.UsuarioDespacho)
                                        ? "Sin usuario"
                                        : envio.UsuarioDespacho)
                                </td>

                                <td>@envio.TotalArticulos</td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @envio.EstadoEnvio
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Envios"
                                       asp-action="Details"
                                       asp-route-id="@envio.IdEnvio"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ver envío">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a asp-action="Confirmar"
                                       asp-route-id="@envio.IdEnvio"
                                       class="btn btn-sm btn-outline-success"
                                       title="Confirmar recepción">
                                        <i class="bi bi-check2-circle"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No hay envíos pendientes de recepción.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
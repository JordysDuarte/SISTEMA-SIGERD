@model SIGERD.ViewModels.Recepciones.RecepcionConfirmViewModel

@{
    ViewData["Title"] = "Confirmar recepción";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Confirmar recepción</h2>
        <p class="text-muted mb-0">
            Revisa el detalle del envío antes de confirmar la recepción.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Volver
    </a>
</div>

<form asp-action="Confirmar" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="IdEnvio" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Datos del envío</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Código</dt>
                <dd class="col-sm-9">@Model.CodigoEnvio</dd>

                <dt class="col-sm-3">Fecha envío</dt>
                <dd class="col-sm-9">@Model.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Fecha despacho</dt>
                <dd class="col-sm-9">
                    @(Model.FechaDespacho.HasValue
                        ? Model.FechaDespacho.Value.ToString("dd/MM/yyyy HH:mm")
                        : "Sin fecha")
                </dd>

                <dt class="col-sm-3">Origen</dt>
                <dd class="col-sm-9">@Model.DelegacionOrigen</dd>

                <dt class="col-sm-3">Destino</dt>
                <dd class="col-sm-9">@Model.DelegacionDestino</dd>

                <dt class="col-sm-3">Usuario registra</dt>
                <dd class="col-sm-9">@Model.UsuarioEnvio</dd>

                <dt class="col-sm-3">Usuario despacha</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.UsuarioDespacho)
                        ? "Sin usuario"
                        : Model.UsuarioDespacho)
                </dd>

                <dt class="col-sm-3">Estado actual</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">@Model.EstadoEnvio</span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Detalle recibido</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Artículo / documento</th>
                            <th>Cantidad</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Detalles != null && Model.Detalles.Any())
                        {
                            int contador = 1;

                            foreach (var detalle in Model.Detalles)
                            {
                                <tr>
                                    <td>@contador</td>
                                    <td>@detalle.Articulo</td>
                                    <td>@detalle.Cantidad</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(detalle.ObservacionesDetalle)
                                            ? "Sin descripción"
                                            : detalle.ObservacionesDetalle)
                                    </td>
                                </tr>

                                contador++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No hay detalles registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Observaciones de recepción</h5>
        </div>

        <div class="card-body">
            <textarea asp-for="Observaciones"
                      class="form-control"
                      rows="3"
                      maxlength="500"
                      placeholder="Escribe alguna observación si es necesario..."></textarea>

            <span asp-validation-for="Observaciones" class="text-danger"></span>
        </div>
    </div>

    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Al confirmar la recepción, el envío cambiará su estado a <strong>Recibido</strong>.
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

        <button type="submit"
                class="btn btn-success"
                onclick="return confirm('¿Confirma que este envío fue recibido correctamente?');">
            <i class="bi bi-check2-circle me-2"></i>
            Confirmar recepción
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
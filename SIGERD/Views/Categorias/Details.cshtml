@model SIGERD.ViewModels.Inventario.Categorias.CategoriaDetailsViewModel

@{
    ViewData["Title"] = "Detalle de categoría";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Detalle de categoría</h2>
        <p class="text-muted mb-0">
            Información general de la categoría seleccionada.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.IdCategoria"
           class="btn btn-outline-warning">
            <i class="bi bi-pencil-square me-2"></i>
            Editar
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Volver
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Información de la categoría</h5>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.IdCategoria</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.NombreCategoria</dd>

            <dt class="col-sm-3">Artículos asociados</dt>
            <dd class="col-sm-9">@Model.TotalArticulos</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Estado)
                {
                    <span class="badge bg-success">Activa</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactiva</span>
                }
            </dd>
        </dl>
    </div>
</div>
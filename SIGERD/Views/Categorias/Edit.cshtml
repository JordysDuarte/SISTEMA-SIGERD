@model SIGERD.ViewModels.Inventario.Categorias.CategoriaEditViewModel

@{
    ViewData["Title"] = "Editar categoría";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Editar categoría</h2>
        <p class="text-muted mb-0">
            Modifica la información de la categoría seleccionada.
        </p>
    </div>

    <a asp-action="Details"
       asp-route-id="@Model.IdCategoria"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Volver
    </a>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="IdCategoria" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">Información de la categoría</h5>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label asp-for="NombreCategoria" class="form-label"></label>

                <input asp-for="NombreCategoria"
                       class="form-control" />

                <span asp-validation-for="NombreCategoria" class="text-danger"></span>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="Estado"
                       class="form-check-input"
                       type="checkbox"
                       role="switch" />

                <label asp-for="Estado" class="form-check-label">
                    Categoría activa
                </label>
            </div>

            <div class="alert alert-light border">
                <i class="bi bi-info-circle me-2"></i>
                Si desactivas una categoría, no se eliminará de la base de datos.
                Esto permite conservar el historial de artículos y envíos asociados.
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details"
                   asp-route-id="@Model.IdCategoria"
                   class="btn btn-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i>
                    Guardar cambios
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model SIGERD.ViewModels.Envios.Envios.EnvioEditViewModel

@{
    ViewData["Title"] = "Editar Envío";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Editar Envío</h2>
        <p class="text-muted mb-0">
            Solo se pueden editar envíos que aún estén en estado Pendiente.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Details"
           asp-route-id="@Model.IdEnvio"
           class="btn btn-outline-primary">
            <i class="bi bi-eye me-2"></i>
            Ver detalle
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Volver
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" id="formEditarEnvio">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="IdEnvio" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Estás editando el envío <strong>@Model.CodigoEnvio</strong>.
        Esta acción solo está permitida mientras el envío se encuentre en estado <strong>Pendiente</strong>.
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Datos generales</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Código</label>
                    <input type="text" class="form-control" value="@Model.CodigoEnvio" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Fecha</label>
                    <input type="text" class="form-control" value="@Model.FechaEnvio.ToString("dd/MM/yyyy HH:mm")" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <input type="text" class="form-control" value="@Model.EstadoEnvio" readonly />
                </div>

                @if (Model.EsSuperAdministrador)
                {
                    <div class="col-md-6">
                        <label asp-for="IdDelegacionOrigen" class="form-label"></label>
                        <select asp-for="IdDelegacionOrigen" asp-items="Model.Delegaciones" class="form-select">
                            <option value="">Seleccione una delegación</option>
                        </select>
                        <span asp-validation-for="IdDelegacionOrigen" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <div class="col-md-6">
                        <label asp-for="IdDelegacionOrigen" class="form-label"></label>

                        <input type="hidden" asp-for="IdDelegacionOrigen" />

                        <input type="text"
                               class="form-control"
                               value="@Model.DelegacionOrigenUsuario"
                               readonly />

                        <div class="form-text">
                            El origen se mantiene según tu delegación.
                        </div>

                        <span asp-validation-for="IdDelegacionOrigen" class="text-danger"></span>
                    </div>
                }

                <div class="col-md-6">
                    <label asp-for="IdDelegacionDestino" class="form-label"></label>
                    <select asp-for="IdDelegacionDestino" asp-items="Model.Delegaciones" class="form-select">
                        <option value="">Seleccione una delegación</option>
                    </select>
                    <span asp-validation-for="IdDelegacionDestino" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones"
                              rows="3"
                              class="form-control"
                              placeholder="Escriba observaciones generales del envío..."></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h5 class="mb-0">Detalles del envío</h5>
                <small class="text-muted">Modifica los artículos, cantidades o descripciones del envío.</small>
            </div>

            <button type="button" class="btn btn-sm btn-outline-primary" id="btnAgregarDetalle">
                <i class="bi bi-plus-circle me-1"></i>
                Agregar línea
            </button>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0" id="tablaDetallesEnvio">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 35%;">Artículo / documento</th>
                            <th style="width: 15%;">Cantidad</th>
                            <th style="width: 40%;">Descripción</th>
                            <th style="width: 10%;" class="text-center">Acción</th>
                        </tr>
                    </thead>

                    <tbody id="contenedorDetalles">
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            <tr class="detalle-row">
                                <td>
                                    <input type="hidden"
                                           name="Detalles[@(i)].IdDetalleEnvio"
                                           value="@Model.Detalles[i].IdDetalleEnvio" />

                                    <select name="Detalles[@(i)].IdArticulo"
                                            id="Detalles_@(i)__IdArticulo"
                                            class="form-select detalle-articulo">

                                        <option value="">Seleccione un artículo</option>

                                        @foreach (var articulo in Model.Articulos)
                                        {
                                            if (Model.Detalles[i].IdArticulo?.ToString() == articulo.Value)
                                            {
                                                <option value="@articulo.Value" selected>@articulo.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@articulo.Value">@articulo.Text</option>
                                            }
                                        }
                                    </select>

                                    <span class="text-danger field-validation-valid"
                                          data-valmsg-for="Detalles[@(i)].IdArticulo"
                                          data-valmsg-replace="true"></span>
                                </td>

                                <td>
                                    <input name="Detalles[@(i)].Cantidad"
                                           id="Detalles_@(i)__Cantidad"
                                           value="@Model.Detalles[i].Cantidad"
                                           class="form-control detalle-cantidad"
                                           type="number"
                                           min="1"
                                           placeholder="Cantidad" />

                                    <span class="text-danger field-validation-valid"
                                          data-valmsg-for="Detalles[@(i)].Cantidad"
                                          data-valmsg-replace="true"></span>
                                </td>

                                <td>
                                    <textarea name="Detalles[@(i)].ObservacionesDetalles"
                                              id="Detalles_@(i)__ObservacionesDetalles"
                                              class="form-control detalle-observacion"
                                              rows="2"
                                              maxlength="500"
                                              placeholder="Detalle específico de esta línea...">@Model.Detalles[i].ObservacionesDetalles</textarea>

                                    <span class="text-danger field-validation-valid"
                                          data-valmsg-for="Detalles[@(i)].ObservacionesDetalles"
                                          data-valmsg-replace="true"></span>
                                </td>

                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger btnEliminarDetalle"
                                            title="Quitar línea">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alert alert-light border mt-3 mb-0">
                <i class="bi bi-info-circle me-2"></i>
                Puedes agregar o quitar líneas mientras el envío siga pendiente.
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Details"
           asp-route-id="@Model.IdEnvio"
           class="btn btn-secondary">
            Cancelar
        </a>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-2"></i>
            Guardar cambios
        </button>
    </div>
</form>

<template id="detalleTemplate">
    <tr class="detalle-row">
        <td>
            <input type="hidden"
                   name="Detalles[__index__].IdDetalleEnvio"
                   value="" />

            <select name="Detalles[__index__].IdArticulo"
                    id="Detalles___index____IdArticulo"
                    class="form-select detalle-articulo">

                <option value="">Seleccione un artículo</option>

                @foreach (var articulo in Model.Articulos)
                {
                    <option value="@articulo.Value">@articulo.Text</option>
                }
            </select>

            <span class="text-danger field-validation-valid"
                  data-valmsg-for="Detalles[__index__].IdArticulo"
                  data-valmsg-replace="true"></span>
        </td>

        <td>
            <input name="Detalles[__index__].Cantidad"
                   id="Detalles___index____Cantidad"
                   class="form-control detalle-cantidad"
                   type="number"
                   min="1"
                   placeholder="Cantidad" />

            <span class="text-danger field-validation-valid"
                  data-valmsg-for="Detalles[__index__].Cantidad"
                  data-valmsg-replace="true"></span>
        </td>

        <td>
            <textarea name="Detalles[__index__].ObservacionesDetalles"
                      id="Detalles___index____ObservacionesDetalles"
                      class="form-control detalle-observacion"
                      rows="2"
                      maxlength="500"
                      placeholder="Detalle específico de esta línea..."></textarea>

            <span class="text-danger field-validation-valid"
                  data-valmsg-for="Detalles[__index__].ObservacionesDetalles"
                  data-valmsg-replace="true"></span>
        </td>

        <td class="text-center">
            <button type="button"
                    class="btn btn-sm btn-outline-danger btnEliminarDetalle"
                    title="Quitar línea">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const contenedorDetalles = document.getElementById("contenedorDetalles");
            const btnAgregarDetalle = document.getElementById("btnAgregarDetalle");
            const detalleTemplate = document.getElementById("detalleTemplate");
            const formEditarEnvio = document.getElementById("formEditarEnvio");

            function obtenerFilas() {
                return contenedorDetalles.querySelectorAll(".detalle-row");
            }

            function reindexarFilas() {
                const filas = obtenerFilas();

                filas.forEach(function (fila, index) {
                    const idDetalle = fila.querySelector("input[name$='.IdDetalleEnvio']");
                    const articulo = fila.querySelector(".detalle-articulo");
                    const cantidad = fila.querySelector(".detalle-cantidad");
                    const observacion = fila.querySelector(".detalle-observacion");

                    const spanArticulo = fila.querySelector("[data-valmsg-for$='.IdArticulo']");
                    const spanCantidad = fila.querySelector("[data-valmsg-for$='.Cantidad']");
                    const spanObservacion = fila.querySelector("[data-valmsg-for$='.ObservacionesDetalles']");

                    if (idDetalle) {
                        idDetalle.name = `Detalles[${index}].IdDetalleEnvio`;
                    }

                    if (articulo) {
                        articulo.name = `Detalles[${index}].IdArticulo`;
                        articulo.id = `Detalles_${index}__IdArticulo`;
                    }

                    if (cantidad) {
                        cantidad.name = `Detalles[${index}].Cantidad`;
                        cantidad.id = `Detalles_${index}__Cantidad`;
                    }

                    if (observacion) {
                        observacion.name = `Detalles[${index}].ObservacionesDetalles`;
                        observacion.id = `Detalles_${index}__ObservacionesDetalles`;
                    }

                    if (spanArticulo) {
                        spanArticulo.setAttribute("data-valmsg-for", `Detalles[${index}].IdArticulo`);
                    }

                    if (spanCantidad) {
                        spanCantidad.setAttribute("data-valmsg-for", `Detalles[${index}].Cantidad`);
                    }

                    if (spanObservacion) {
                        spanObservacion.setAttribute("data-valmsg-for", `Detalles[${index}].ObservacionesDetalles`);
                    }
                });
            }

            function agregarFila() {
                const index = obtenerFilas().length;
                const html = detalleTemplate.innerHTML.replaceAll("__index__", index);

                contenedorDetalles.insertAdjacentHTML("beforeend", html);
                reindexarFilas();
            }

            function eliminarFila(boton) {
                const filas = obtenerFilas();

                if (filas.length <= 1) {
                    const fila = boton.closest(".detalle-row");

                    if (fila) {
                        fila.querySelectorAll("select, input, textarea").forEach(function (control) {
                            control.value = "";
                        });
                    }

                    return;
                }

                boton.closest(".detalle-row").remove();
                reindexarFilas();
            }

            btnAgregarDetalle.addEventListener("click", function () {
                agregarFila();
            });

            contenedorDetalles.addEventListener("click", function (event) {
                const botonEliminar = event.target.closest(".btnEliminarDetalle");

                if (botonEliminar) {
                    eliminarFila(botonEliminar);
                }
            });

            formEditarEnvio.addEventListener("submit", function () {
                reindexarFilas();
            });

            if (obtenerFilas().length === 0) {
                agregarFila();
            }
        });
    </script>
}
@model IEnumerable<SIGERD.ViewModels.Envios.Envios.EnvioListViewModel>

@{
    ViewData["Title"] = "Gestión de Envíos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Gestión de Envíos</h2>
        <p class="text-muted mb-0">Consulta los envíos registrados en el sistema.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Nuevo Envío
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Fecha</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Usuario</th>
                        <th>Estado</th>
                        <th>Total artículos</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var envio in Model)
                        {
                            <tr>
                                <td>@envio.CodigoEnvio</td>
                                <td>@envio.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@envio.DelegacionOrigen</td>
                                <td>@envio.DelegacionDestino</td>
                                <td>@envio.UsuarioEnvio</td>
                                <td>
                                    <span class="badge
                                        @(envio.EstadoEnvio.Equals("Recibido", StringComparison.OrdinalIgnoreCase) ? "bg-success" :
                                          envio.EstadoEnvio.Equals("Pendiente", StringComparison.OrdinalIgnoreCase) ? "bg-secondary" :
                                          envio.EstadoEnvio.Equals("En tránsito", StringComparison.OrdinalIgnoreCase) || envio.EstadoEnvio.Equals("En transito", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark" :
                                          envio.EstadoEnvio.Equals("Cancelado", StringComparison.OrdinalIgnoreCase) ? "bg-danger" :
                                          "bg-primary")">
                                        @envio.EstadoEnvio
                                    </span>
                                </td>
                                <td>@envio.TotalArticulos</td>
                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@envio.IdEnvio"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ver detalle">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No hay envíos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>